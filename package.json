  ],
  "author": "Christian Diekmann",
  "license": "MIT",
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "ads-client": "^2.2.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
