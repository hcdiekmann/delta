{
  "name": "delta-robot-sim",
  "version": "1.0.0",
  "description": "Browser-based 3D delta robot simulation with optional Beckhoff PLC connection via ADS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js --ignore serverLog.db --ignore localhost/"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "delta-robot",
